{
  "name": "debug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "dev": "tsx scripts/dev.ts",
    "lint": "oxlint src server scripts tests",
    "lint:fix": "oxlint --write src server scripts tests",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@zcode/shared": "workspace:*",
    "hono": "^4.13.13",
    "http-mitm-proxy": "^1.1.0",
    "lucide-react": "^1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vis-timeline": "^8.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.5"
  }
}
