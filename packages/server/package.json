{
  "name": "@zcode/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./stdio": "./src/stdio.ts",
    "./remote": "./src/remote/index.ts",
    "./remote/*.js": "./src/remote/*.ts"
  },
  "scripts": {
    "dev": "tsup --watch --onSuccess 'node dist/entry-http.js'",
    "build": "tsup && pnpm run build:remote",
    "build:remote": "tsx build-remote.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@zcode/client": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "axios": "^1.20.0",
    "combined-stream": "^1.0.8",
    "follow-redirects": "^1.16.1",
    "form-data": "^4.0.6",
    "hono": "^4.13.13",
    "node-forge": "^1.4.0",
    "node-pty": "^1.0.0",
    "proxy-from-env": "^1.1.0",
    "ssh2": "^1.17.0",
    "undici": "^6.24.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
