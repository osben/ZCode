{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"]
  },
  "include": ["src"],
  // The server directly imports shared, services, client, and rpc.
  // Incomplete references previously made the build follow package entry points into source files,
  // which duplicated and amplified RPC errors.
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../client" },
    { "path": "../rpc" }
  ]
}
