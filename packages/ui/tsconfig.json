{
  "extends": "../../tsconfig.base.json",
  // Reason for the fix: The UI package follows NodeNext ESM resolution, so package imports must resolve directly to real file paths.
  // ai-elements previously self-imported @zcode/ui/... from inside the package and often omitted internal .js extensions,
  // running into both package exports restrictions and NodeNext path-resolution failures.
  // Keep the current configuration and use relative package imports with .js extensions consistently so development, builds, and type checks agree.
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Bugfix: In some tsserver/incremental-project states, a directory include ("src") can leave a newly created file
  // visible in the CLI output from `tsc --showConfig` while the editor briefly reports “file not in project file list.”
  // Use an explicit glob to reliably include ts/tsx/d.ts source files under the UI package, avoiding false missing-file reports for new modules such as settings-page helpers.
  // Also include .json files under src (such as recommendedPlugins.json) so resolveJsonModule imports are included in the project file list.
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.json"],
  // UI also uses RPC types directly; adding a project reference prevents UI from rechecking RPC source as its own input.
  "references": [
    { "path": "../provider" },
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" }
  ]
}
