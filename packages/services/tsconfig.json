{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025"],
    "types": ["node"]
  },
  "include": ["src"],
  // Without a project reference to rpc, tsc checks rpc as a regular source dependency
  // repeatedly, causing the same errors to appear in multiple consumers.
  // Add the reference so services consumes rpc's declaration output directly.
  "references": [{ "path": "../shared" }, { "path": "../rpc" }]
}
