{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"]
  },
  "include": ["src"],
  // The client depends directly on rpc. Without an explicit rpc project reference, typecheck recompiles rpc source through the workspace package entry point.
  // With this reference, the client reads rpc's generated declaration files first.
  "references": [{ "path": "../services" }, { "path": "../rpc" }]
}
