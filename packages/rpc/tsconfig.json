{
  // Make this a composite project because consumers previously followed the package export and checked
  // the RPC source repeatedly.
  // As a standalone project consumed through project references, typecheck reuses RPC's generated
  // declarations instead of printing the same errors multiple times.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    // Cause: rrweb's transitive dependency on the older @types/css-font-loading-module duplicates DOM
    // declarations included with newer TypeScript versions.
    // RPC does not extend the root tsconfig and previously checked third-party declarations, causing
    // bootstrap to fail on this dependency type conflict.
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
