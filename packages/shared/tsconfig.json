{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Bugfix: the runtime feature helper is intentionally kept as JS so the Node prepare script
    // and TypeScript packages can import the same runtime contract before shared is built.
    // allowJs lets the shared build copy that JS, preventing dist/index.js from exporting a nonexistent file.
    "allowJs": true
  },
  "include": ["src"]
}
