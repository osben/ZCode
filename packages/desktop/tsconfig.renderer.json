{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    "rootDir": "src/renderer",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/renderer"],
  // The renderer imports shared directly; adding it as a reference prevents standalone renderer checks from falling back to source files.
  "references": [{ "path": "../shared" }, { "path": "../ui" }, { "path": "../client" }]
}
