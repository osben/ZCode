{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/e2e",
    "rootDir": ".",
    "lib": ["es2025", "dom", "dom.iterable"],
    "types": ["node", "@wdio/globals/types", "@wdio/electron-types", "mocha"],
    "noEmit": true,
    "paths": {
      "@zcode/e2e-report": ["../e2e-report/src/node/index.ts"]
    }
  },
  "include": [
    "wdio.conf.ts",
    "test/e2e",
    "src/host/botRemoteWorkspaceResolver.ts",
    "src/host/sourceServerDirectory.ts",
    "src/host/windowRemoteConnectionRegistry.ts"
  ],
  // TEMPORARY(relay-decision): these four e2e files target upstream relay v2, which is not adopted until the user decides. Remove this exclude when the relay decision lands.
  "exclude": [
    "test/e2e/helpers/web-remote-unread.ts",
    "test/e2e/conversation-session/manual-review/pending/conversation-session-web-remote-unread.test.ts",
    "test/e2e/conversation-session/manual-review/pending/conversation-session-web-remote-project-directory.test.ts",
    "test/e2e/conversation-session/manual-review/pending/conversation-session-virtual-project-mobile.test.ts"
  ],
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../e2e-report" },
    { "path": "../zcode-server-cli" }
  ]
}
