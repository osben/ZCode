{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/host",
    "rootDir": "src/host",
    "lib": ["es2025"]
  },
  "include": ["src/host"],
  // Host depends directly on services/shared and imports rpc; adding project references prevents typecheck from compiling rpc source again.
  "references": [{ "path": "../shared" }, { "path": "../services" }, { "path": "../rpc" }]
}
