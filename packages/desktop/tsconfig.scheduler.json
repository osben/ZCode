{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/scheduler",
    "rootDir": "src/scheduler",
    "lib": ["es2025"],
    // The scheduler uses Electron.MessageEvent only as a type and does not import the "electron" value,
    // so include the Node and Electron global types explicitly (process/setInterval/Electron namespace).
    "types": ["node", "electron"]
  },
  "include": ["src/scheduler"],
  // The scheduler directly depends on the Node entry of services and on shared; add references to reuse their generated declarations.
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
