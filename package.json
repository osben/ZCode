{
  "name": "zcode",
  "version": "3.17.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:relay": "pnpm --filter @zcode/remote-relay dev",
    "build:relay": "pnpm --filter @zcode/remote-relay build",
    "test:relay": "node scripts/run-vitest.mjs run --project relay",
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server dev\" \"pnpm --filter @zcode/web dev\"",
    "dev:docs": "pnpm --filter @zcode/dev-docs dev",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:e2e-report": "pnpm --filter @zcode/e2e-report dev",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:web-remote-control": "node scripts/build-desktop-agent-cli.mjs && concurrently -k -n web,desktop -c green,magenta \"pnpm --filter @zcode/web exec vite dev --strictPort\" \"node scripts/dev-web-remote-control-desktop.mjs\"",
    "dev:web-share:test": "node scripts/dev-web-share-env.mjs test",
    "dev:web-share:mock": "node scripts/dev-web-share-env.mjs mock",
    "dev:server": "pnpm --filter @zcode/server dev",
    "dev:official-mcp": "node scripts/dev-official-mcp-server.mjs",
    "prepare": "node scripts/install-git-hooks.mjs && pnpm build:cua",
    "prepare:desktop-runtime": "pnpm --filter @zcode/desktop prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "audit:agent-remnants": "node scripts/audit-zcode-agent-remnants.mjs",
    "audit:conversation-session-coverage": "node scripts/audit-conversation-session-case-coverage.mjs --check",
    "audit:conversation-session-complete": "node scripts/audit-conversation-session-case-coverage.mjs --check --require-complete",
    "test": "pnpm run test:engineering && pnpm run test:fork && pnpm run test:node && pnpm run test:relay",
    "test:fork": "node scripts/run-vitest.mjs run --project fork-unit --project fork-isolated",
    "test:node": "tsx --tsconfig packages/ui/tsconfig.json --test packages/services/test/botMessagesLocale.test.ts packages/services/test/branchMergeStatusService.test.ts packages/services/test/outputStyleService.test.ts packages/services/test/userInstructionsService.test.ts packages/services/test/voiceDictation.test.ts packages/services/test/voiceDictationRpc.test.ts packages/services/test/voiceModelLanguages.test.ts packages/services/test/voicePostProcess.test.ts packages/services/test/zcodeUpstreamBaseVersion.test.ts packages/ui/test/branchMergeStatusProbeRunner.test.ts packages/ui/test/chatErrorResume.test.ts packages/ui/test/i18nCatalogParity.test.ts packages/ui/test/intlPlural.test.ts packages/ui/test/localeContentCatalogs.test.ts packages/ui/test/localeFormatting.test.ts packages/ui/test/localeSettingsSchema.test.ts packages/ui/test/localeSupport.test.ts packages/ui/test/sessionThroughput.test.ts packages/ui/test/themeContrast.test.ts packages/ui/test/themeMigration.test.ts packages/ui/test/updateReleaseNotes.test.ts packages/ui/test/userInstructionsEditorModel.test.ts packages/ui/test/voiceDictation.test.ts scripts/fork-format.test.mjs scripts/fork-release-version.test.mjs scripts/run-pre-commit-checks.test.mjs scripts/check-staged-file-tokens.test.mjs scripts/test/build-time-config.test.mjs scripts/test/instruction-commands.test.mjs scripts/test/fork-test-files.test.mjs packages/services/test/systemPromptService.test.ts packages/services/test/sessionPullRequestMapping.test.ts packages/services/test/sessionPullRequestsService.test.ts packages/services/test/sessionPullRequestsServiceLogging.test.ts packages/services/test/sessionPullRequestsIntegration.test.ts packages/ui/test/pullRequestStatusProbeRunner.test.ts",
    "test-copy:check": "node scripts/check-test-copy.mjs",
    "instruction-commands:check": "node scripts/check-instruction-commands.mjs",
    "test:e2e": "pnpm --filter @zcode/desktop test:e2e",
    "test:e2e:all:coverage": "pnpm --filter @zcode/desktop test:e2e:all:coverage",
    "test:e2e:windows:sharded": "pnpm --filter @zcode/desktop test:e2e:windows:sharded",
    "test:e2e:container": "bash scripts/test-desktop-e2e-container.sh",
    "test:e2e:container:conversation": "bash scripts/test-desktop-e2e-container.sh conversation-session-verified",
    "test:e2e:container:plugins": "bash scripts/test-desktop-e2e-container.sh plugins-verified",
    "test:git-hooks": "node --test scripts/test/lefthook-commit.test.mjs scripts/test/lefthook-push.test.mjs scripts/test/lefthook-install.test.mjs",
    "test:pre-push": "node --test scripts/test/run-pre-push.test.mjs scripts/test/affected-engineering-test-cli.test.mjs",
    "test:docker:web-app-gateway": "node scripts/test-web-app-gateway-reset.mjs",
    "verify:pre-push": "node scripts/run-pre-push.mjs",
    "check:push-worktree": "node scripts/check-push-worktree.mjs",
    "build": "pnpm -r build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:docs": "pnpm --filter @zcode/dev-docs build",
    "build:web-remote-control:test": "pnpm --filter @zcode/web exec vite build --base=/remote/__test__/",
    "build:web-share": "pnpm --filter @zcode/web-share build",
    "build:zcode": "node scripts/build-zcode.mjs",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@zcode/desktop\" build && pnpm --filter @zcode/desktop build:no-runtime-assets",
    "build:sea": "pnpm --dir apps/zcode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/zcode-cli build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "ci:ensure-native-search-deps": "node scripts/ensure-native-search-deps.mjs",
    "ci:verify-electron-builder-mirror": "node scripts/verify-electron-builder-binaries-mirror.mjs",
    "test:native-search:e2e": "node scripts/test-native-search-tools-e2e.mjs",
    "test:sea-runtime-tools:e2e": "node scripts/test-sea-runtime-tools-e2e.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/acp-agent-runtime packages/shared packages/services packages/client packages/server packages/zcode-server-cli packages/remote-relay packages/ui packages/web apps/dev-docs packages/e2e-report packages/desktop/tsconfig.host.json packages/desktop/tsconfig.e2e.json",
    "bundle:desktop": "pnpm --filter @zcode/desktop run bundle --",
    "fmt": "node scripts/fork-format.mjs",
    "fmt:check": "node scripts/fork-format.mjs --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "node scripts/prepare-prebuilds.mjs",
    "prepare:remote-assets:linux": "node scripts/prepare-prebuilds.mjs --linux",
    "ci:assert-node": "node scripts/assert-node-version.mjs",
    "build:cua": "pnpm --filter @zcode/zcode-cua build",
    "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:fork": "node scripts/release-fork.mjs",
    "release:cli": "pnpm --dir apps/zcode-cli run release",
    "release:cli:dry": "pnpm --dir apps/zcode-cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "test:architecture": "node --test scripts/test/architecture-governance.test.mjs scripts/test/architecture-governance-review.test.mjs scripts/test/architecture-upstream-admission.test.mjs scripts/test/source-size-policy.test.mjs scripts/test/architecture-default-branch.test.mjs scripts/test/pre-push-worktree.test.mjs scripts/test/retired-app-unit-evidence.test.mjs",
    "architecture:adopt": "node scripts/architecture/architecture-check.mjs adopt",
    "db:migrations:check": "node --test scripts/test/upstream-migration-baseline.test.mjs && tsx --test scripts/test/check-upstream-migrations.test.ts && tsx scripts/check-upstream-migrations.ts",
    "db:migrations:baseline:update": "tsx scripts/check-upstream-migrations.ts --update",
    "docs:stale-phrases:check": "node scripts/check-stale-doc-phrases.mjs",
    "db:schema:check": "node --test scripts/test/sqlite-schema-contract.test.mjs && pnpm --dir apps/zcode-cli exec tsx ../../scripts/check-sqlite-schema.ts",
    "db:schema:update": "pnpm --dir apps/zcode-cli exec tsx ../../scripts/check-sqlite-schema.ts --update",
    "provider:regression:report": "tsx apps/zcode-cli/tools/provider-regression/src/report-cli.ts",
    "provider:regression": "pnpm --filter @zcode/bootstrap... build && tsx apps/zcode-cli/tools/provider-regression/src/cli.ts",
    "test:engineering": "node scripts/run-vitest.mjs run --project engineering",
    "test:engineering:affected": "node scripts/run-affected-engineering-tests.mjs",
    "test:engineering-tools": "node --test scripts/test/affected-engineering-test-cli.test.mjs scripts/test/pre-push-worktree.test.mjs scripts/test/retired-app-unit-evidence.test.mjs scripts/test/e2e-remote-targets-check.test.mjs",
    "check:e2e-remote-targets": "node scripts/check-e2e-remote-targets.mjs"
  },
  "dependencies": {
    "border-beam": "^1.4.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.14.17",
    "@types/node": "^26.0.0",
    "@zcode/zcode-cua": "workspace:*",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^18.0.7",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "^29.1.1",
    "knip": "^6.0.6",
    "lefthook": "2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.14.17"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
