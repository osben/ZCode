{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // Only add the Hooks rules in this override and keep the original plugins, so the full React default rule set is not enabled.
      "files": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "plugins": ["unicorn", "typescript", "oxc", "react"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn"
      }
    },
    {
      // The 20 existing call-site diagnostics from the first scan stay warnings; remove each exception once its file is fixed, never widen to a directory.
      // Dependency diagnostics and other rules are not downgraded; see docs/testing/react-hooks-lint.md.
      "files": [
        "**/packages/desktop/test/e2e/helpers/web-remote-visibility-browser.ts",
        "**/packages/ui/src/ToolCallBlocks/renderers/resume-workflow-run.tsx",
        "**/packages/ui/src/hooks/useOnboardingRecordService.ts",
        "**/packages/ui/src/hooks/useZCodeAgentService.ts",
        "**/packages/ui/src/hooks/useZCodeSessionService.ts",
        "**/packages/ui/src/hooks/useZCodeTaskService.ts",
        "**/packages/ui/src/project-sidebar/grouped/task-row.tsx",
        // Fork tests: a plain test helper named use*, and hooks called inside renderHook callbacks.
        "**/packages/services/test/zcodeLegacyTaskCompatTaskIndex.test.ts",
        "**/packages/ui/test/pullRequestRefreshSignals.test.ts"
      ],
      "plugins": ["unicorn", "typescript", "oxc", "react"],
      "rules": {
        "react/rules-of-hooks": "warn"
      }
    },
    {
      // The session-control core depends only on contracts and injected ports; never couple the runtime environment back into use cases.
      "files": ["packages/session-control/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "node:*/**",
                  "fs",
                  "fs/**",
                  "child_process",
                  "worker_threads",
                  "net",
                  "http",
                  "https",
                  "http2",
                  "dgram",
                  "dns",
                  "dns/**",
                  "tls",
                  "os",
                  "path",
                  "path/**",
                  "crypto",
                  "stream",
                  "stream/**",
                  "timers",
                  "timers/**",
                  "process",
                  "module",
                  "vm",
                  "electron",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "zustand",
                  "zustand/**",
                  "@zcode/services",
                  "@zcode/services/**",
                  "@zcode/shared",
                  "@zcode/shared/**",
                  "@zcode/core",
                  "@zcode/core/**",
                  "@zcode/bootstrap",
                  "@zcode/bootstrap/**",
                  "@zcode/adapters",
                  "@zcode/adapters/**",
                  "**/services/src/**",
                  "**/apps/zcode-cli/**"
                ],
                "message": "Session control uses injected ports; environment and host implementations belong in adapters."
              },
              {
                "group": [
                  "../cli/**",
                  "../app/**",
                  "../../cli/**",
                  "../../app/**",
                  "@zcode/session-control/cli",
                  "@zcode/session-control/app",
                  "#src/application/cli/**",
                  "#src/application/app/**",
                  "#session-control/application/cli/**",
                  "#session-control/application/app/**"
                ],
                "message": "CLI and App use cases are independent; share contracts or pure domain rules instead."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "process",
          "window",
          "fetch",
          "setTimeout",
          "setInterval",
          "Date"
        ]
      }
    },
    {
      // Existing large implementations kept as warnings only; they are not split mechanically in this sync.
      "files": [
        // Marketplace keeps the upstream large-file shape and only adds directory field projection.
        "**/apps/zcode-cli/packages/adapters/src/plugins/marketplace.ts",
        // MCP connection entry keeps the upstream implementation; the connection barrier fix does not reflow the adapter.
        "**/apps/zcode-cli/packages/adapters/src/mcp/index.ts",
        // The streaming runner keeps the upstream large-file shape; the workflow unknown-business-code retry limit only passes
        // the attempt count to the policy table, and the attempt loop is not split to satisfy line counts.
        "**/apps/zcode-cli/packages/adapters/src/model/runner-stream.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/plugins.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/migrations.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/create-app.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/session-facade.ts",
        // The v4 authoritative projection keeps the upstream large-file shape; the queue identity fix does not split the projector mechanically for line counts.
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection.ts",
        // Background agent terminal states are now delivered as structured originMeta; this only adds pass-through and cold-recovery read-back,
        // and does not split the projection mechanically for line counts.
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/transcript-hydration.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/v4-gateway.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/conversation-topic-publisher.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/cold-event-merge.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/server.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/session-mapper.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-bridge.ts",
        "**/apps/zcode-cli/packages/contracts/src/interfaces/session-store.port.ts",
        // Already over the limit at origin/integration; the 3.16.1 sync keeps these shapes and only warns.
        "**/apps/zcode-cli/packages/adapters/src/fs/index.ts",
        "**/apps/zcode-cli/packages/adapters/src/plugins/index.ts",
        // The model contract inherits the upstream 901-line file; this change only adds configuration network error codes and does not split the public contract for it.
        "**/apps/zcode-cli/packages/contracts/src/model/index.ts",
        // The fork selection fallback only adds one hidden-reminder check; the fork flow is not split mechanically for line counts.
        "**/apps/zcode-cli/packages/core/src/runtime/methods/session-fork.ts",
        "**/apps/zcode-cli/packages/core/src/tool/executor/background-tasks.ts",
        "**/apps/zcode-cli/packages/debug/server/analyzer.ts",
        "**/apps/zcode-cli/packages/debug/src/App.tsx",
        "**/apps/zcode-cli/packages/telemetry/src/agent-trace-runtime.ts",
        // Telemetry lints with --no-ignore from its package directory, so it matches the cwd-relative path.
        "src/agent-trace-runtime.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/steering.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn-model-step.ts",
        // Inside the core package, oxlint runs with --no-ignore and matches the same files by cwd-relative paths.
        "src/runtime/methods/session-fork.ts",
        "src/runtime/methods/steering.ts",
        "src/runtime/methods/turn.ts",
        "src/runtime/methods/turn-model-step.ts",
        "src/tool/executor/background-tasks.ts",
        "**/packages/ui/src/remote-connection-flow/index.ts"
      ],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // Test files naturally accumulate scenarios and assertions, so the production line limit would create false positives.
      // Disable max-lines only for test/spec files to avoid relaxing the business-code constraint.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".claude/skills",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "packages/zcode-cua",
    "docs/electron"
  ]
}
