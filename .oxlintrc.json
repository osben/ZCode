{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // Existing large implementations kept as warnings only; they are not split mechanically in this sync.
      "files": [
        // Marketplace keeps the upstream large-file shape and only adds directory field projection.
        "**/apps/zcode-cli/packages/adapters/src/plugins/marketplace.ts",
        // MCP connection entry keeps the upstream implementation; the connection barrier fix does not reflow the adapter.
        "**/apps/zcode-cli/packages/adapters/src/mcp/index.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/plugins.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/migrations.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/create-app.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/session-facade.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/v4-gateway.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/server.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/session-mapper.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-bridge.ts",
        "**/apps/zcode-cli/packages/contracts/src/interfaces/session-store.port.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/steering.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn-model-step.ts",
        // Inside the core package, oxlint runs with --no-ignore and matches the same files by cwd-relative paths.
        "src/runtime/methods/steering.ts",
        "src/runtime/methods/turn.ts",
        "src/runtime/methods/turn-model-step.ts",
        "**/packages/ui/src/remote-connection-flow/index.ts"
      ],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // Test files naturally accumulate scenarios and assertions, so the production line limit would create false positives.
      // Disable max-lines only for test/spec files to avoid relaxing the business-code constraint.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".claude/skills",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "packages/zcode-cua",
    "docs/electron"
  ]
}
